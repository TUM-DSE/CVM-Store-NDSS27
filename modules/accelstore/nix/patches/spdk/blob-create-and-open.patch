+/**
+ * Create a new blob with options on the given blobstore and hand it back open.
+ * The new blob will be passed to the callback function.
+ *
+ * The blob is registered in the blobstore with one reference, which belongs to
+ * the caller and must be returned with spdk_blob_close(). Against a
+ * spdk_bs_create_blob_ext() followed by a spdk_bs_open_blob(), this saves
+ * reading the md page the create has just persisted back from the device.
+ *
+ * External snapshot clones cannot be created this way: opts->esnap_id must be
+ * NULL, otherwise the operation fails with -EINVAL.
+ *
+ * \param bs blobstore.
+ * \param opts The structure which contains the option values for the new blob.
+ * \param cb_fn Called when the operation is complete.
+ * \param cb_arg Argument passed to function cb_fn.
+ */
+void spdk_bs_create_and_open_blob(struct spdk_blob_store *bs, const struct spdk_blob_opts *opts,
+				  spdk_blob_op_with_handle_complete cb_fn, void *cb_arg);
+
 /**
  * Create a read-only snapshot of specified blob with provided options.
  * This will automatically sync specified blob.
diff --git a/lib/blob/blobstore.c b/lib/blob/blobstore.c
index d8a5b39..579be6c 100644
--- a/lib/blob/blobstore.c
+++ b/lib/blob/blobstore.c
@@ -6261,11 +6261,40 @@ bs_create_blob_cpl(spdk_bs_sequence_t *seq, void *cb_arg, int bserrno)
 		spdk_spin_unlock(&blob->bs->used_lock);
 	}
 
+	if (seq->cpl.type == SPDK_BS_CPL_TYPE_BLOB_HANDLE) {
+		if (bserrno == 0) {
+			/* The caller asked for the blob to be handed back open. Its in-memory
+			 * state is the md image that was just persisted, so registering it here
+			 * spares the caller an spdk_bs_open_blob() that would read that same
+			 * page back from the device. The reference taken here belongs to the
+			 * caller, which returns it with spdk_blob_close().
+			 */
+			blob->open_ref++;
+			spdk_bit_array_set(blob->bs->open_blobids, blob->id);
+			RB_INSERT(spdk_blob_tree, &blob->bs->open_blobs, blob);
+
+			bs_sequence_finish(seq, 0);
+			return;
+		}
+		seq->cpl.u.blob_handle.blob = NULL;
+	}
+
 	blob_free(blob);
 
 	bs_sequence_finish(seq, bserrno);
 }
 
+static void
+bs_create_blob_fail(spdk_blob_op_with_id_complete cb_fn,
+		    spdk_blob_op_with_handle_complete open_cb_fn, void *cb_arg, int bserrno)
+{
+	if (open_cb_fn != NULL) {
+		open_cb_fn(cb_arg, NULL, bserrno);
+	} else {
+		cb_fn(cb_arg, 0, bserrno);
+	}
+}
